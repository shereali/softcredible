# Docker Compose secrets — DO NOT COMMIT. Copy this to `.env` and fill in real values.
# Used by docker-compose.yml for the Softcredible stack.

# MySQL
DB_PASSWORD=change-me-strong-db-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# Laravel app key — generate with: php artisan key:generate --show (or openssl rand -base64 32)
APP_KEY=base64:change-me-32-byte-key

# Admin user (seeded on startup)
ADMIN_EMAIL=admin@softcredible.com
ADMIN_PASSWORD=change-me-strong-admin-password

# Mail (log fallback by default)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=leads@softcredible.com
MAIL_FROM_NAME=Softcredible
