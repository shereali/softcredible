APP_NAME=Softcredible
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database — defaults to SQLite for local development
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=softcredible
# DB_USERNAME=root
# DB_PASSWORD=

# Session / cache / queue
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN — initial admin user (created by `php artisan db:seed`)
#
# IMPORTANT: change ADMIN_PASSWORD in production. The seeded default is
# only for local development.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@softcredible.com
ADMIN_PASSWORD=password

# ─────────────────────────────────────────────────────────────────────────────
# MAIL — Lead notification email
#
# Default (no MAIL_MAILER set): notifications are written to the Laravel log
# (storage/logs/laravel.log) so lead capture works without any mail server.
#
# To send real email, uncomment and configure:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-username
# MAIL_PASSWORD=your-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=leads@softcredible.com
# MAIL_FROM_NAME=Softcredible
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=leads@softcredible.com
MAIL_FROM_NAME=Softcredible
