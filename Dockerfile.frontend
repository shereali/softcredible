# ─────────────────────────────────────────────────────────────────────────────
# Frontend — Nuxt 4 (Node server runtime, not pure static)
# Multi-stage: build with node:22, run with node:22-alpine
# Caddy (the host reverse proxy) routes public traffic straight to the Node
# server on :3000 — no internal nginx needed.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

# Install dependencies (use lockfile for reproducible builds)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source
COPY . .

# Build (produces .output/ with the Nitro Node server)
ARG NUXT_PUBLIC_API_BASE=http://backend:8000/api
ENV NUXT_PUBLIC_API_BASE=$NUXT_PUBLIC_API_BASE
RUN npm run build

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --from=build /app/.output ./.output
COPY --from=build /app/package.json ./package.json

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
