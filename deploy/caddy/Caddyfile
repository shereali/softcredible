# ─────────────────────────────────────────────────────────────────────────────
# Caddyfile — routes all projects on this VPS by host.
#
# softcredible.com: serves the Softcredible project. Caddy obtains Let's
# Encrypt TLS automatically once the A record points here.
# :80 fallback: serves the project on the raw IP over HTTP (works even before
# DNS propagates; keep until the domain is confirmed).
# ─────────────────────────────────────────────────────────────────────────────

softcredible.com, www.softcredible.com {
    encode gzip

    # API → Laravel backend (nginx in the backend container on :8000)
    handle /api/* {
        reverse_proxy softcredible-backend-1:8000
    }

    # Everything else → Nuxt frontend (Node server in the frontend container)
    handle {
        reverse_proxy softcredible-frontend-1:3000
    }

    # Headers
    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# No domain yet — serve the first project on any host over HTTP.
# Remove this block once the domain + TLS are confirmed working.
:80 {
    handle /api/* {
        reverse_proxy softcredible-backend-1:8000
    }
    handle {
        reverse_proxy softcredible-frontend-1:3000
    }
}

# ── Template for additional projects (uncomment per project) ────────────────
# project2.com, www.project2.com {
#     reverse_proxy project2-frontend-1:3000
# }
